#include <cudf/column/column_device_view.cuh>

#include "hash/jit_lto_kernels/murmurhash3_x86_32_lto.cuh"

namespace cudf::hashing::detail {

template <>
__device__ hash_value_type murmur_jit_hasher<@storage_cpp@>(column_device_view col,
                                                            uint32_t seed,
                                                            bool nullable,
                                                            size_type row_index)
{
  return hasher<@storage_cpp@>(col, seed, nullable, row_index);
}

}  // namespace cudf::hashing::detail
